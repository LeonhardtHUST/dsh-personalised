{
  "name": "dsh-personalised",
  "description": "Personalisation for DeepSeek Harness: stable custom system instructions, relevance-based personal memory, workspace-scoped project memory, and one-click memory import/export across AI platforms. DeepSeek Harness 个性化：稳定的自定义系统指令、按相关性注入的个人记忆、按工作区隔离的项目记忆，以及跨 AI 平台的记忆导入导出。",
  "version": "1.0.1",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "test": "node tools/run-smoke.mjs",
    "commitlint": "commitlint --edit",
    "hooks:enable": "vp hooks enable",
    "hooks:status": "vp hooks status"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "python",
    "skins",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "!python/bench",
    "!python/__pycache__",
    "!**/node_modules",
    "!**/*.bak*",
    "!lib/*.m8b*bak*",
    "!lib/*.*.*"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "personalisation",
    "personalization",
    "custom-instructions",
    "memory",
    "memory-import",
    "plugin"
  ],
  "homepage": "https://github.com/LeonhardtHUST/dsh-personalised#readme",
  "bugs": {
    "url": "https://github.com/LeonhardtHUST/dsh-personalised/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonhardtHUST/dsh-personalised.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.7.6"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-angular": "^21.2.4",
    "vite-plus": "^1.6.0"
  }
}
